+package com.emipokemon.v050a12;
+
+import org.junit.jupiter.api.Test;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class Version050Alpha12RegressionTest {
+    private static String read(String path) throws Exception {
+        return Files.readString(Path.of(path));
+    }
+
+    private static String sha256(String path) throws Exception {
+        byte[] bytes = Files.readAllBytes(Path.of(path));
+        return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes));
+    }
+
+    @Test
+    void versionAndDungeonLevelSyncAreEnabled() throws Exception {
+        assertTrue(read("gradle.properties").contains("mod_version=0.5.0-alpha.12"));
+        assertTrue(read("src/main/java/com/emipokemon/Emipokemon.java").contains("VERSION = \"0.5.0-alpha.12\""));
+        String battle = read("src/main/java/com/emipokemon/npc/NpcBattleService.java");
+        assertTrue(battle.contains("dungeonLevelSyncConfig"));
+        assertTrue(battle.contains("BattleFormatProvider"));
+        assertTrue(battle.contains("withAdjustPlayerLevels"));
+        assertTrue(battle.contains("copyCobblemonFormatWithLevel"));
+        assertTrue(battle.contains("Level Sync activo"));
+    }
+
+    @Test
+    void levelSyncUsesBattleClonesAndNeverRewritesStoredParty() throws Exception {
+        String battle = read("src/main/java/com/emipokemon/npc/NpcBattleService.java");
+        assertTrue(battle.contains("The stored Cobblemon party is therefore never rewritten"));
+        assertTrue(battle.contains("getCobblemonBattleFormat"));
+        assertTrue(battle.contains("targetLevel"));
+        assertFalse(battle.contains("pokemon.setLevel(target"));
+        assertFalse(battle.contains("setLevel(targetLevel"));
+        assertTrue(battle.contains("combate se bloqueó para no modificar tus Pokémon reales"));
+    }
+
+    @Test
+    void failedStartBattleUuidIsNotReportedAsSuccess() throws Exception {
+        String battle = read("src/main/java/com/emipokemon/npc/NpcBattleService.java");
+        assertTrue(battle.contains("if (result == null) return false;"));
+    }
+
+    @Test
+    void approvedEmiToolTexturesRemainByteIdentical() throws Exception {
+        assertEquals("1540614909181e432680a0860ed39702553929919b45b7681155b07d981e078b",
+                sha256("src/main/resources/assets/emipokemon/textures/item/emi_sword.png"));
+        assertEquals("6954d581169275d213046e41772a57f934ab0ffd84f311e2ea6fc344e0d0c1d7",
+                sha256("src/main/resources/assets/emipokemon/textures/item/emi_pickaxe.png"));
+        assertEquals("fe9d4f5d41e86122fcf040f5381bf173e0b0f5334a7314f95ce5a89e2a96774a",
+                sha256("src/main/resources/assets/emipokemon/textures/item/emi_axe.png"));
+        assertEquals("f528d40ff3f1cd947b5a6e2b8bbea9e5a0b2f4bbbec17b4eaaabf0a5d484399a",
+                sha256("src/main/resources/assets/emipokemon/textures/item/emi_shovel.png"));
+        assertEquals("946b14b5ce1f31295c8be2cc401aff91bc63173051f10e8d6de6e6fde3690ca2",
+                sha256("src/main/resources/assets/emipokemon/textures/item/emi_hoe.png"));
+    }
+}
