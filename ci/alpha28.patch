@@ -25,10 +25,19 @@ public abstract class TextDisplayHologramMixin {
             CallbackInfoReturnable<DisplayEntity.TextDisplayEntity.Data> cir
     ) {
         DisplayEntity.TextDisplayEntity.Data data = cir.getReturnValue();
-        if (data == null) return;
+        if (data == null || !HologramTextResolver.isEmipokemonDisplay(entity)) return;
