         Text resolved = HologramTextResolver.resolve(entity, data.text());
-        if (resolved == data.text() || resolved.equals(data.text())) return;
+
+        // Vanilla TextDisplayEntity uses bit 0x02 for SEE_THROUGH. Clear it on the
+        // client as a second line of defence so alpha.26/27 entities already loaded
+        // in a world cannot keep rendering through solid blocks.
+        byte depthTestedFlags = (byte) (data.flags() & ~0x02);
